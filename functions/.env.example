# Copy to functions/.env (git-ignored) and fill in your SMTP provider's settings.
# The SMTP password is NOT stored here. Set it in Secret Manager:
#   firebase functions:secrets:set SMTP_PASS
#
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com
#   and an App Password (Google Account > Security > App passwords) as SMTP_PASS.
# SendGrid example: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=465, SMTP_USER=apikey
#   and your SendGrid API key as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
MAIL_FROM="BranchFlow <your-address@gmail.com>"
